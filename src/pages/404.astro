---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import { u } from '../lib/url';
---
<Base title="Page not found" description="This page could not be found." noindex>
  <PageHero title="This path is <span class='accent'>off the map</span>" lead="The page you were looking for has moved or does not exist.">
    <div class="hero-ctas"><a class="btn btn--gold" href={u('/')}>Back to home</a><a class="btn btn--ghost" href={u('/tailor-made-umrah/')}>Tailor-made Umrah</a></div>
  </PageHero>
</Base>
