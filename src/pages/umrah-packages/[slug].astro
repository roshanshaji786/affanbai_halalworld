---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import Icon from '../../components/Icon.astro';
import Faq from '../../components/Faq.astro';
import Enquiry from '../../components/Enquiry.astro';
import PackageCard from '../../components/PackageCard.astro';
import { packages, itinerary, inclusionInfo, faqs, inr, site, waLink, arabic, type Package } from '../../data/site';
import { u } from '../../lib/url';

export function getStaticPaths() {
  return packages.map((p) => ({ params: { slug: p.slug }, props: { p } }));
}
const { p } = Astro.props as { p: Package };
const days = itinerary(p);
const others = packages.filter((o) => o.slug !== p.slug).slice(0, 3);
const crumbs = [{ name: 'Umrah packages', href: '/umrah-packages/' }, { name: p.name, href: `/umrah-packages/${p.slug}/` }];
const pageUrl = new URL(u(`/umrah-packages/${p.slug}/`), Astro.site).href;
const pkgFaqs = faqs.slice(0, 4);
const schema = [
  {
    '@context': 'https://schema.org',
    '@type': ['TouristTrip', 'Product'],
    name: p.name,
    description: p.description,
    url: pageUrl,
    image: new URL(u('/og.jpg'), Astro.site).href,
    brand: { '@type': 'Brand', name: site.name },
    touristType: p.bestFor,
    itinerary: { '@type': 'ItemList', itemListElement: [{ '@type': 'ListItem', position: 1, item: { '@type': 'City', name: 'Makkah' } }, { '@type': 'ListItem', position: 2, item: { '@type': 'City', name: 'Madinah' } }] },
    provider: { '@id': `${site.url}/#agency` },
    ...(p.startsFrom ? { offers: { '@type': 'Offer', price: p.startsFrom, priceCurrency: 'INR', availability: 'https://schema.org/InStock', url: pageUrl, seller: { '@id': `${site.url}/#agency` } } } : {}),
  },
  { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: pkgFaqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) },
];
const msg = `Assalamu alaikum, I am interested in the ${p.name} (${p.days} days). Please share dates and the fare.`;
---
<Base title={`${p.name}: ${p.days} days from Kerala`} description={`${p.name} from Thiruvananthapuram and Kochi: ${p.makkahNights} nights in Makkah, ${p.madinahNights} in Madinah, ${p.hotelClass} hotels ${p.distance.toLowerCase()}. ${p.startsFrom ? `From ${inr(p.startsFrom)} per person.` : 'Ask for this month’s fare.'}`} crumbs={crumbs} schema={schema}>
  <PageHero title={p.name} lead={p.short} crumbs={crumbs} ar={arabic.umrah}>
    <ul class="facts">
      <li><b>{p.days} days</b>Total trip</li>
      <li><b>{p.makkahNights} + {p.madinahNights}</b>Nights Makkah + Madinah</li>
      <li><b>{p.hotelClass}</b>Hotels</li>
      <li><b>{p.startsFrom ? inr(p.startsFrom) : 'On request'}</b>{p.startsFrom ? 'Starts from, per person' : 'Fare'}</li>
    </ul>
  </PageHero>
  <section class="section">
    <div class="container with-aside">
      <div class="prose">
        <h2>About this package</h2>
        <p>{p.description}</p>
        <ul class="chips" style="margin:18px 0 8px">{p.highlights.map((h) => <li>{h}</li>)}</ul>
        <h2>Day-by-day plan</h2>
        <ol class="timeline">{days.map((d) => <li><small>{d.day}</small><h3>{d.title}</h3><p>{d.text}</p></li>)}</ol>
        <p class="note">Dates and the exact order of ziyarat depend on your flights. You get the final plan in writing before you pay.</p>
        <h2>What’s included</h2>
        <ul class="ticks">{p.includes.map((k) => <li><Icon name="check" /><span><strong>{inclusionInfo[k].title}.</strong> {inclusionInfo[k].text}</span></li>)}</ul>
        <h2>Not included</h2>
        <ul class="ticks ticks--x">{p.excludes.map((x) => <li><Icon name="x" /><span>{x}</span></li>)}</ul>
        <h2>Hotels</h2>
        <p>{p.hotelExamples}. {p.distance}. Rooms: {p.room.toLowerCase()}.</p>
        <h2>Who this suits</h2>
        <p>{p.bestFor}. Not sure it’s right for you? Message us who is travelling and we will suggest the best fit.</p>
        <h2>Questions</h2>
        <Faq items={pkgFaqs} />
      </div>
      <aside class="aside-sticky">
        <div class="aside-card">
          <div class="price">{p.startsFrom ? <><small>Starts from, per person</small><strong>{inr(p.startsFrom)}</strong></> : <><small>Fare</small><strong style="font-size:1.6rem">Ask for this month’s fare</strong></>}</div>
          <dl>
            <dt>Duration</dt><dd>{p.days} days</dd>
            <dt>Makkah</dt><dd>{p.makkahNights} nights</dd>
            <dt>Madinah</dt><dd>{p.madinahNights} nights</dd>
            <dt>Hotels</dt><dd>{p.hotelClass}</dd>
            <dt>Meals</dt><dd>{p.meals}</dd>
            <dt>Flying from</dt><dd>{site.airports.map((a) => a.code).join(' or ')}</dd>
          </dl>
          <a class="btn btn--wa" href={waLink(msg)} target="_blank" rel="noopener" data-wa={`pkg-${p.slug}`}><Icon name="whatsapp" />Ask about this package</a>
          <a class="btn btn--ghost" href={`tel:${site.phoneE164}`}><Icon name="phone" />Call {site.phone}</a>
        </div>
      </aside>
    </div>
  </section>
  <section class="section section--pattern">
    <div class="container">
      <div class="head"><h2>Other packages</h2></div>
      <div class="grid grid--3">{others.map((o) => <PackageCard p={o} />)}</div>
    </div>
  </section>
  <Enquiry preset={p.slug} />
</Base>
