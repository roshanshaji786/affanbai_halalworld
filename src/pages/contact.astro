---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Enquiry from '../components/Enquiry.astro';
import { site } from '../data/site';
const crumbs = [{ name: 'Contact', href: '/contact/' }];
---
<Base title="Contact Halal World, Trivandrum" description={`Call or WhatsApp Halal World on ${site.phone}, or visit our office in Thiruvananthapuram. ${site.hoursText}.`} crumbs={crumbs}>
  <PageHero title='Talk to us' lead={`WhatsApp or call ${site.phone}. ${site.hoursText}.`} crumbs={crumbs} />
  <Enquiry title="Send your details and we’ll reply on WhatsApp." />
</Base>
