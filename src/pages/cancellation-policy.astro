---
import Legal from '../layouts/Legal.astro';
import { site } from '../data/site';
---
<Legal title="Cancellation policy" description={`Cancellation and refund terms for ${site.name} bookings.`} path="/cancellation-policy/">
  <h2>Before the visa is filed</h2><p>Your advance is refunded, minus any non-refundable airline or hotel charges already paid on your behalf.</p>
  <h2>After the visa is filed</h2><p>Visa fees are non-refundable. Flight and hotel refunds follow the rules of each airline and hotel.</p>
  <h2>How to cancel</h2><p>Message or call us on {site.phone}. We confirm every cancellation and refund amount in writing.</p>
</Legal>
