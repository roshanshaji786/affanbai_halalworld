---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import NextJourney from '../components/NextJourney.astro';
import Kicker from '../components/Kicker.astro';
import Icon from '../components/Icon.astro';
import Faq from '../components/Faq.astro';
import talbiyah from '../data/talbiyah.json';
import Enquiry from '../components/Enquiry.astro';
import { site, umrahWays, services, faqs, cities, arabic, nextJourney } from '../data/site';
import { u } from '../lib/url';

const allServices = [
  { icon: 'sliders', title: 'Tailor-made Umrah', text: 'Your dates, your days and your hotel distance from the Haram.', href: '/tailor-made-umrah/' },
  { icon: 'users', title: 'Group Umrah with an Ameer', text: 'Guided groups every March, July and November.', href: '/group-umrah/' },
  ...services.map((s) => ({ ...s, href: s.icon === 'visa' ? '/umrah-visa/' : '/travel-services/' })),
];
const homeFaqs = [faqs[4], faqs[5], faqs[0], faqs[3]];
const wayHref: Record<string, string> = { 'tailor-made': '/tailor-made-umrah/', 'group-departures': '/group-umrah/' };
const schema = [{
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: homeFaqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
}, {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: site.name,
  url: site.url,
}, {
  '@context': 'https://schema.org',
  '@type': 'TouristTrip',
  name: nextJourney.title,
  touristType: 'Pilgrims',
  provider: { '@id': `${site.url}/#agency` },
  itinerary: { '@type': 'ItemList', itemListElement: nextJourney.route.map((n, i) => ({ '@type': 'ListItem', position: i + 1, item: { '@type': 'Place', name: n } })) },
  offers: { '@type': 'Offer', price: nextJourney.price, priceCurrency: 'INR', availability: 'https://schema.org/InStock', validThrough: nextJourney.date },
}];
---
<Base
  title="Halal World | Travel consultancy for flights, visas, hotels and Umrah"
  description="Halal World is a travel consultancy serving travellers across India. Tailor-made Umrah on your dates and hotel distance, group Umrah with an Ameer every March, July and November, plus flights, visas and hotels worldwide."
  schema={schema}
>
  <Hero />

  <section class="section" id="services" aria-labelledby="svc-title">
    <div class="container">
      <div class="head reveal">
        <Kicker ar={arabic.services} text="What we do" />
        <h2 id="svc-title">Every journey, <span class="accent">one consultant.</span></h2>
        <p class="lead">Umrah is the heart of our work, and we book every other trip too, for travellers from anywhere in India.</p>
      </div>
      <div class="services services--all reveal">
        {allServices.map((s) => <a class="service" href={u(s.href)}><Icon name={s.icon} /><div><h3>{s.title}</h3><p>{s.text}</p></div></a>)}
      </div>
    </div>
  </section>

  <section class="section section--tint" id="departure" aria-labelledby="journey-title">
    <div class="container"><NextJourney /></div>
  </section>

  <section class="section section--pattern" aria-labelledby="umrah-title">
    <div class="container">
      <div class="head reveal">
        <Kicker ar={arabic.umrah} text="Umrah" />
        <svg class="talbiyah talbiyah--light" viewBox={talbiyah.viewBox} role="img" aria-label={`${talbiyah.text} (Labbayk Allahumma Labbayk)`} lang="ar"><path d={talbiyah.d} /></svg>
        <h2 id="umrah-title">Two ways to go. <span class="accent">Both planned by us.</span></h2>
        <p class="lead">Most of our pilgrims choose a tailor-made Umrah. If you would rather travel with others and a guide, join one of our three group departures a year.</p>
      </div>
      <div class="ways">
        {umrahWays.map((w, i) => (
          <article class:list={['way', 'reveal', { 'way--primary': i === 0 }]}>
            <span class="way-kicker">{w.kicker}</span>
            <h3>{w.name}</h3>
            <p>{w.short}</p>
            <ul class="ticks">{w.points.slice(0, 4).map((p) => <li><Icon name="check" /><span>{p}</span></li>)}</ul>
            <a class="link" href={u(wayHref[w.slug])}>{i === 0 ? 'How tailor-made works' : 'Group dates and details'} <Icon name="arrow" /></a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--tint" aria-labelledby="how-title">
    <div class="container">
      <div class="head reveal">
        <Kicker ar={arabic.journey} text="How we work" />
        <h2 id="how-title">A conversation first, <span class="accent">then a plan.</span></h2>
      </div>
      <ol class="steps reveal">
        <li><h3>Talk to us</h3><p>On WhatsApp, by phone or at our office. Tell us who is travelling and what matters.</p></li>
        <li><h3>Get a written plan</h3><p>Dates, flights, hotels with their distance, and the full fare. No hidden extras.</p></li>
        <li><h3>We handle the paperwork</h3><p>Visa, tickets and vouchers, checked twice before anything is filed.</p></li>
        <li><h3>Travel, with us on call</h3><p>We stay on WhatsApp from departure until you are home.</p></li>
      </ol>
    </div>
  </section>

  <section class="section" aria-labelledby="faq-title">
    <div class="container split">
      <div class="reveal">
        <Kicker ar={arabic.questions} text="Questions" />
        <h2 id="faq-title">Good to know</h2>
      </div>
      <Faq items={homeFaqs} />
    </div>
  </section>

  <Enquiry />
</Base>
