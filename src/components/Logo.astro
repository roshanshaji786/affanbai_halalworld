---
// Wordmark placeholder drawn from the poster's logo. TODO: swap for the official logo file when available.
interface Props { tagline?: boolean }
const { tagline = true } = Astro.props;
---
<svg class="brand-mark" viewBox="0 0 48 48" aria-hidden="true">
  <circle cx="24" cy="24" r="22.5" fill="none" stroke="currentColor" stroke-opacity=".35" />
  <path d="M24 5l5 12.2L41 22l-12 4.9L24 39l-5-12.1L7 22l12-4.8z" fill="none" stroke="#a9853f" stroke-width="1.4" />
  <path d="M15.5 33V15M15.5 24h11M26.5 15v18" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" />
  <path d="M30 13.5l7-4.5-2.2 3.6 1 3.1-1.6-.6-1.8 2.2-.3-2z" fill="#a9853f" />
</svg>
<span class="brand-name">Halal world{tagline && <span class="brand-tag">Travel through the earth</span>}</span>
