---
import Logo from './Logo.astro';
import { site, packages, cities, guides } from '../data/site';
import { u } from '../lib/url';
const regs = site.registrations.filter((r) => r.value);
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="container">
    <div class="footer-grid">
      <div class="footer-brand">
        <a class="brand" href={u('/')}><Logo /></a>
        <p>Umrah packages and journeys of faith from Kerala, planned end to end by a team in Thiruvananthapuram.</p>
        {regs.length > 0 && <div class="regs">{regs.map((r) => <span>{r.label}: {r.value}</span>)}</div>}
      </div>
      <div>
        <h2>Packages</h2>
        <ul>{packages.map((p) => <li><a href={u(`/umrah-packages/${p.slug}/`)}>{p.name}</a></li>)}</ul>
      </div>
      <div>
        <h2>Umrah from</h2>
        <ul>
          {cities.map((c) => <li><a href={u(`/umrah-packages-from-${c.slug}/`)}>{c.name}</a></li>)}
          <li><a href={u('/umrah-visa/')}>Umrah visa</a></li>
          {guides.map((g) => <li><a href={u(`/umrah-guide/${g.slug}/`)}>{g.title.split(',')[0]}</a></li>)}
        </ul>
      </div>
      <div>
        <h2>Contact</h2>
        <ul>
          <li><a href={`tel:${site.phoneE164}`}>{site.phone}</a></li>
          <li><a href={`mailto:${site.email}`}>{site.email}</a></li>
          <li>{[site.address.street, site.address.locality, site.address.region].filter(Boolean).join(', ')}</li>
          <li>{site.hoursText}</li>
          <li><a href={u('/about/')}>About us</a></li>
        </ul>
      </div>
    </div>
    <div class="footer-bottom">
      <span>© {year} {site.name}. All rights reserved.</span>
      <span><a href={u('/privacy/')}>Privacy</a> · <a href={u('/terms/')}>Terms</a> · <a href={u('/cancellation-policy/')}>Cancellation policy</a></span>
    </div>
  </div>
</footer>
