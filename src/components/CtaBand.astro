---
import Icon from './Icon.astro';
import { site, waLink } from '../data/site';
interface Props { title?: string; text?: string }
const { title = 'Ready when you are, in sha Allah.', text = 'Message us your month and how many are travelling. We reply with a plan and a fare.' } = Astro.props;
---
<div class="container"><div class="cta-band reveal">
  <div><h2>{title}</h2><p class="lead" style="color:rgba(246,240,230,.8);margin:12px 0 0">{text}</p></div>
  <div class="actions">
    <a class="btn btn--gold" href={waLink()} target="_blank" rel="noopener" data-wa="band"><Icon name="whatsapp" />WhatsApp us</a>
    <a class="btn btn--ghost" href={`tel:${site.phoneE164}`}><Icon name="phone" />{site.phone}</a>
  </div>
</div></div>
