---
import Icon from './Icon.astro';
import { site, waLink } from '../data/site';
interface Props { title?: string; text?: string; wa?: string }
const { title = 'Tell us where and when. We’ll plan the rest.', text = 'A short WhatsApp message is enough to start: your month, how many are travelling, and anything that matters to you.', wa } = Astro.props;
---
<div class="container"><div class="cta-band reveal">
  <div><h2>{title}</h2><p class="lead" style="margin:12px 0 0">{text}</p></div>
  <div class="actions">
    <a class="btn btn--wa" href={waLink(wa)} target="_blank" rel="noopener" data-wa="band"><Icon name="whatsapp" />WhatsApp us</a>
    <a class="btn btn--line" href={`tel:${site.phoneE164}`}><Icon name="phone" />{site.phone}</a>
  </div>
</div></div>
