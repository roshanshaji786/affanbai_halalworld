---
import Icon from './Icon.astro';
import talbiyah from '../data/talbiyah.json';
import { site, waLink } from '../data/site';
import { u } from '../lib/url';
---
<section class="hero" aria-labelledby="hero-title">
  <div class="container hero-inner">
    <div class="hero-copy">
      <span class="hero-eyebrow"><b>Umrah</b>Travel consultancy in Trivandrum</span>
      <svg class="talbiyah" viewBox={talbiyah.viewBox} role="img" aria-label={`${talbiyah.text} (Labbayk Allahumma Labbayk)`} lang="ar">
        <path d={talbiyah.d} />
      </svg>
      <span class="talbiyah-tr">“Here I am, O Allah, here I am.”</span>
      <h1 id="hero-title">Umrah and travel, <span class="accent">planned around you</span></h1>
      <p class="lead">Tell us your dates, how many days and how close to the Haram you want to stay. We build the Umrah to fit, and book every other trip too.</p>
      <div class="hero-ctas">
        <a class="btn btn--gold" href={waLink('Assalamu alaikum, I would like to plan a tailor-made Umrah.')} target="_blank" rel="noopener" data-wa="hero"><Icon name="whatsapp" />Plan my Umrah</a>
        <a class="btn btn--ghost" href={u('/#departure')}>Next group departure <Icon name="arrow" /></a>
      </div>
      <ul class="hero-trust">
        <li>Tailor-made, your dates</li>
        <li>Groups with an Ameer</li>
        <li>Flights, visas, hotels</li>
      </ul>
    </div>
    <div class="hero-visual" data-globe>
      <img class="globe-fallback" src={u('/globe-fallback.svg')} alt="" width="600" height="600" fetchpriority="low" decoding="async" />
    </div>
  </div>
  <div class="hero-route">
    <div class="container route" aria-label="Typical Umrah route">
      <span class="stop">{site.airports.map((a) => a.code).join(' · ')}<small>Kerala</small></span><span class="dot"></span>
      <span class="stop">JED<small>Jeddah</small></span><span class="dot"></span>
      <span class="stop">Makkah<small>Umrah and prayers</small></span><span class="dot"></span>
      <span class="stop">Madinah<small>Masjid an-Nabawi</small></span><span class="dot"></span>
      <span class="stop">Home<small>with Zamzam</small></span>
    </div>
  </div>
</section>
<script>
  // Load the 3D globe only after the page is interactive, and only where it will run smoothly.
  const host = document.querySelector<HTMLElement>('[data-globe]');
  const nav = navigator as Navigator & { connection?: { saveData?: boolean; effectiveType?: string }; deviceMemory?: number };
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const slowNet = nav.connection?.saveData || /(^|-)2g/.test(nav.connection?.effectiveType ?? '');
  const weak = (nav.deviceMemory !== undefined && nav.deviceMemory < 3) || (nav.hardwareConcurrency !== undefined && nav.hardwareConcurrency < 4);
  // Skip WebGL where it would be rendered in software (slow and battery-hungry); the still globe stays.
  const gl = (() => {
    try {
      const ctx = document.createElement('canvas').getContext('webgl2');
      if (!ctx) return false;
      const dbg = ctx.getExtension('WEBGL_debug_renderer_info');
      const r = dbg ? String(ctx.getParameter(dbg.UNMASKED_RENDERER_WEBGL)) : '';
      ctx.getExtension('WEBGL_lose_context')?.loseContext();
      return location.search.includes('globe=force') || !/swiftshader|llvmpipe|software|basic render/i.test(r);
    } catch { return false; }
  })();
  if (host && !reduce && !slowNet && !weak && gl) {
    let started = false;
    const events = ['pointermove', 'pointerdown', 'touchstart', 'scroll', 'keydown', 'wheel'] as const;
    const go = () => {
      if (started) return;
      started = true;
      events.forEach((e) => removeEventListener(e, go));
      import('../scripts/globe').then((m) => m.mount(host)).catch(() => {});
    };
    const arm = () => {
      events.forEach((e) => addEventListener(e, go, { once: true, passive: true }));
      setTimeout(() => ('requestIdleCallback' in window ? requestIdleCallback(go, { timeout: 2000 }) : go()), 3500);
    };
    if (document.readyState === 'complete') arm(); else addEventListener('load', arm, { once: true });
  }
</script>
