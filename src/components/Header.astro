---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import { nav } from '../data/nav';
import { site, waLink } from '../data/site';
import { u } from '../lib/url';
const here = Astro.url.pathname;
const isCurrent = (href: string) => here.startsWith(u(href));
---
<header class="site-header" data-header>
  <div class="container">
    <a class="brand" href={u('/')}><Logo /></a>
    <nav class="nav" aria-label="Main">
      {nav.map((n) => <a href={u(n.href)} aria-current={isCurrent(n.href) ? 'page' : undefined}>{n.label}</a>)}
    </nav>
    <a class="btn btn--line btn--sm header-cta" href={waLink()} target="_blank" rel="noopener" data-wa="header"><Icon name="whatsapp" />WhatsApp</a>
    <button class="menu-btn" type="button" aria-label="Open menu" aria-expanded="false" aria-controls="mobile-menu" data-menu-btn><span></span></button>
  </div>
</header>
<div class="mobile-menu" id="mobile-menu" data-menu>
  <a href={u('/')}>Home</a>
  {nav.map((n) => <a href={u(n.href)}>{n.label}</a>)}
  <a class="btn btn--wa btn--block" href={waLink()} target="_blank" rel="noopener" data-wa="menu"><Icon name="whatsapp" />WhatsApp us</a>
  <a class="btn btn--line btn--block" href={`tel:${site.phoneE164}`}><Icon name="phone" />Call {site.phone}</a>
</div>
