---
import Base from './Base.astro';
import PageHero from '../components/PageHero.astro';
interface Props { title: string; description: string; path: string }
const { title, description, path } = Astro.props;
const crumbs = [{ name: title, href: path }];
---
<Base title={title} description={description} crumbs={crumbs}>
  <PageHero title={title} crumbs={crumbs} />
  <section class="section"><div class="container"><div class="prose"><p class="note">Draft for review. Please have these terms checked before going live.</p><slot /></div></div></section>
</Base>
